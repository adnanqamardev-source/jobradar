# deps
node_modules/
.pnpm-store/

# git worktrees (agent isolation — see notes.md)
# Each is a full checkout of this repo, so `git add -A` from the main tree must never
# see its contents. Listed here rather than left to a global ignore, because an agent
# running `git add -A` would otherwise stage another worktree's entire source tree.
/.worktrees/

# env — .env.example is the only one committed
.env
.env.local
.env.*.local

# next
.next/
out/
build/
next-env.d.ts

# testing
coverage/
playwright-report/
test-results/
blob-report/

# local tooling binaries (fetched by `pnpm secret:install`, never committed)
tools/

# vercel
.vercel/

# logs & os
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# supabase local
supabase/.temp/
supabase/.branches/

# sentry
.sentryclirc

# build artifacts
tsconfig.tsbuildinfo