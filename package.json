    "@sentry/nextjs": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "15.x",
    "react": "19.x",
    "react-dom": "19.x",
    "react-email": "latest",
    "resend": "latest",
    "stripe": "latest",
    "tailwind-merge": "latest",
    "zod": "3.x"
  },
  "devDependencies": {
    "@eslint/js": "latest",
