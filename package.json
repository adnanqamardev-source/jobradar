{
  "name": "jobradar",
  "version": "0.1.0",
  "private": true,
  "description": "Automated job finding workflow — scrape, dedupe, rank, track.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
