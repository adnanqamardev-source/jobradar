# ─────────────────────────────────────────────────────────────
# JobRadar environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Full reference: docs/02-technical-architecture.md §7.1
# ─────────────────────────────────────────────────────────────

# ── Supabase (safe to expose) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Must NEVER be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bearer token verified (constant-time) by every /api/cron/* route
CRON_SECRET=
# Comma-separated emails granted admin on first deploy
ADMIN_EMAILS=

# ── Firecrawl — scraping / search / map ──────────────────────
FIRECRAWL_API_KEY=

# ── OpenRouter — embeddings + rationale ───────────────────────
# Free-only: both model ids must end in ":free" or env validation throws.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 2048-dim, 32k ctx. Do NOT send `dimensions` — this model 400s on any other value.
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_CHAT_MODEL=qwen/qwen3.8-27b:free

# ── Job source APIs (Tier 1 is keyless) ──────────────────────
# Greenhouse / Lever / Ashby / Remotive / Arbeitnow need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_AUTHORIZATION_KEY=
# Optional aggregator — leave blank unless enabled after legal review
RAPIDAPI_KEY=

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=JobRadar <hi@example.com>

# ── Rate limits (server-only) ────────────────────────────────
# Left blank, these fall back to the defaults below. docs/02 §7.1
RATE_LIMIT_APPLY_PER_MINUTE=10
RATE_LIMIT_SAVE_PER_MINUTE=30
RATE_LIMIT_DISMISS_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=60

# ── Stripe (SHOULD — billing) ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=

# ── Analytics & errors ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Optional ─────────────────────────────────────────────────
# Slack digest (NICE) — leave blank to hide the feature
SLACK_WEBHOOK_URL=
