# ─────────────────────────────────────────────────────────────
# JobRadar environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Full reference: docs/02-technical-architecture.md §7.1
# ─────────────────────────────────────────────────────────────

# ── Supabase (safe to expose) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Must NEVER be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bearer token verified (constant-time) by every /api/cron/* route
CRON_SECRET=
# Comma-separated emails granted admin on first deploy
ADMIN_EMAILS=

# ── Firecrawl — scraping / search / map ──────────────────────
FIRECRAWL_API_KEY=

# ── OpenAI — embeddings + rationale ──────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Job source APIs (Tier 1 is keyless) ──────────────────────
# Greenhouse / Lever / Ashby / Remotive / Arbeitnow need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_AUTHORIZATION_KEY=
# Optional aggregator — leave blank unless enabled after legal review
RAPIDAPI_KEY=

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=JobRadar <hi@example.com>

# ── Stripe (SHOULD — billing) ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=

# ── Analytics & errors ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Optional ─────────────────────────────────────────────────
# Slack digest (NICE) — leave blank to hide the feature
SLACK_WEBHOOK_URL=
